.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

work/*
!work/.gitkeep
work_hanzistyleforge_fusion_fast/*
!work_hanzistyleforge_fusion_fast/.gitkeep
# Work directories for any other configuration, including backend runs.
work_*/
!work_hanzistyleforge_fusion_fast/
build/*
!build/.gitkeep

fonts/*.ttf
fonts/*.otf
fonts/*.ttc
fonts/*.otc
refs/*.ttf
refs/*.otf
refs/*.ttc
refs/*.otc

*.pt
*.pth
*.ckpt
*.onnx
*.log
*.tmp
*.bak
STOP_AFTER_CHECKPOINT
*.hanzistyleforge.lock
# Optional upstream IDS data downloaded directly by the user
data/cjkvi-ids/*
!data/cjkvi-ids/.gitkeep
*_cmp.png
